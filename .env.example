# Application Environment Configuration
APP_NAME="Newswire Intelligence & Compliance Monitor"
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Database Configuration
# For local SQLite development:
DATABASE_URL=sqlite:///./data/news.db
# For PostgreSQL with Docker:
# DATABASE_URL=postgresql://newswire:newswire_secret@db:5432/newswire_db

# Scheduler & Ingestion Settings
AUTO_POLL_ENABLED=True
POLLING_INTERVAL_MINUTES=15
DEFAULT_ARTICLES_PER_FEED=25
REQUEST_TIMEOUT_SECONDS=15

# Optional External News APIs
# NEWSAPI_KEY=your_newsapi_org_key_here
# GNEWS_API_KEY=your_gnews_io_key_here

# NLP & Compliance Configuration
NLTK_DATA=/opt/nltk_data
DEFAULT_LANGUAGE=en
COMPLIANCE_CRITICAL_WEIGHT=35
COMPLIANCE_HIGH_WEIGHT=20
COMPLIANCE_MEDIUM_WEIGHT=10
COMPLIANCE_LOW_WEIGHT=5
